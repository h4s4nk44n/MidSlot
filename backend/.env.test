# Test-only env. Loaded by jest.setup.ts before any test file runs.
# DO NOT use these values in production.

NODE_ENV=test
JWT_SECRET=test_jwt_secret_at_least_32_characters_long_for_assertion_xx
JWT_ACCESS_TTL=1h
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=test_refresh_secret_at_least_32_characters_long_xxxxxxxx
JWT_REFRESH_TTL=7d
# connection_limit caps each test file's Prisma pool so the full suite (many
# PrismaClient instances) can't exhaust Postgres max_connections — matters most
# under coverage instrumentation, which runs slower and overlaps more.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/midslot_test?schema=public&connection_limit=5
DISABLE_RATE_LIMIT=true
# Pin the auth limiter to 5 so auth.rateLimit.test.ts (expects 429 on the 6th
# login) stays deterministic regardless of the higher dev/prod default.
AUTH_RATE_LIMIT_MAX=5
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3001
