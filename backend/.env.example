# Backend env — used for LOCAL (non-Docker) `npm run dev`.
# In Docker, values are injected by docker-compose.yml from the root .env.
# Copy to .env and fill in real secrets:  cp .env.example .env

# Server
PORT=3000
NODE_ENV=development

# Database — update with your actual PostgreSQL credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/midslot?schema=public"

# JWT — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_generate_a_secure_random_string_min_32_chars
JWT_EXPIRES_IN=1h

# Refresh token (use a SEPARATE secret from JWT_SECRET)
REFRESH_TOKEN_SECRET=CHANGE_ME_generate_a_different_random_string_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:5173

# Background scheduler (MEDI-101) — node-cron running the auto-cancel sweep and
# the 24h reminder loop, independent of HTTP traffic. Never runs under
# NODE_ENV=test. Set SCHEDULER_ENABLED=false to turn the cron off.
SCHEDULER_ENABLED=true
# Cron expression for the maintenance cycle. Default: every 15 minutes.
SCHEDULER_CRON=*/15 * * * *

# Email (MEDI-98) — env-controlled adapter. "console" (default) logs emails;
# "resend" delivers via the Resend API (needs RESEND_API_KEY + EMAIL_FROM);
# "smtp" delivers via any SMTP server (Gmail, Brevo, …) and reaches ANY
# recipient. Tests always use a fake transport, never a real provider.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=MediSlot <noreply@medislot.example>

# SMTP transport — only used when EMAIL_PROVIDER=smtp. Gmail setup: set
# EMAIL_PROVIDER=smtp above, EMAIL_FROM to your own Gmail (e.g. You <you@gmail.com>),
# and SMTP_PASS to a Gmail "App Password" (16 chars, requires 2-Step Verification —
# NOT your normal password). Other hosts: Brevo=smtp-relay.brevo.com,
# Outlook=smtp.office365.com.
SMTP_HOST=smtp.gmail.com
# 587 = STARTTLS (keep SMTP_SECURE=false); 465 = implicit TLS (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false
# Full login address, e.g. yourname@gmail.com
SMTP_USER=
# Gmail App Password (16 chars, no spaces)
SMTP_PASS=

# Public base URL of the frontend (MEDI-100) — used to build the password reset
# link in emails, e.g. {APP_BASE_URL}/reset-password?token=...
APP_BASE_URL=http://localhost:3001
